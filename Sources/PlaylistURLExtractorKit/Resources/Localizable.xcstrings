{
  "sourceLanguage": "en",
  "strings": {
    "%lld links copied to the clipboard": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld link copied to the clipboard"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld links copied to the clipboard"
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bağlantı panoya kopyalandı"
          }
        }
      }
    },
    "%lld videos found": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld video found"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld videos found"
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld video bulundu"
          }
        }
      }
    },
    "%lld videos found, %lld private or deleted skipped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@videos@, %#@skipped@"
          },
          "substitutions": {
            "videos": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg video found"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg videos found"
                    }
                  }
                }
              }
            },
            "skipped": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg private or deleted skipped"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg private or deleted skipped"
                    }
                  }
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld video bulundu, gizli veya silinmiş %2$lld video atlandı"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal"
          }
        }
      }
    },
    "Clear messages when something's wrong": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sorun olduğunda anlaşılır mesajlar"
          }
        }
      }
    },
    "Copy All": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümünü Kopyala"
          }
        }
      }
    },
    "Copy all links to the clipboard or save them as a plain text file.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm bağlantıları panoya kopyalayın veya düz metin dosyası olarak kaydedin."
          }
        }
      }
    },
    "Copy or save the whole list": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listenin tamamını kopyalayın veya kaydedin"
          }
        }
      }
    },
    "Every link in a playlist, in one click": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir listedeki tüm bağlantılar, tek tıkla"
          }
        }
      }
    },
    "Extract Links": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıları Çıkar"
          }
        }
      }
    },
    "Fetching playlist…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynatma listesi alınıyor…"
          }
        }
      }
    },
    "Fetching playlist… %lld videos so far": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Fetching playlist… %lld video so far"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Fetching playlist… %lld videos so far"
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynatma listesi alınıyor… şu ana kadar %lld video"
          }
        }
      }
    },
    "File saved": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya kaydedildi"
          }
        }
      }
    },
    "Google Privacy Policy": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Gizlilik Politikası"
          }
        }
      }
    },
    "Launch at Login": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girişte Başlat"
          }
        }
      }
    },
    "Mixes, Watch Later and Liked lists can't be listed. Try a regular public playlist.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karışımlar, Daha Sonra İzle ve Beğenilenler listelenemez. Normal, herkese açık bir oynatma listesi deneyin."
          }
        }
      }
    },
    "No internet connection. Check your network and try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet bağlantısı yok. Ağınızı kontrol edip tekrar deneyin."
          }
        }
      }
    },
    "Paste a playlist link or ID first.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir oynatma listesi bağlantısı veya kimliği yapıştırın."
          }
        }
      }
    },
    "Paste a public playlist link and get a clean list of video links right from your menu bar.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkese açık bir oynatma listesi bağlantısını yapıştırın, video bağlantılarının temiz listesini doğrudan menü çubuğunuzdan alın."
          }
        }
      }
    },
    "Paste a public playlist link to list every video link in it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçindeki tüm video bağlantılarını listelemek için herkese açık bir oynatma listesi bağlantısı yapıştırın."
          }
        }
      }
    },
    "Paste from Clipboard": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panodan Yapıştır"
          }
        }
      }
    },
    "Playlist link or ID": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynatma listesi bağlantısı veya kimliği"
          }
        }
      }
    },
    "Playlist not found. It may have been deleted, or the link is incomplete.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynatma listesi bulunamadı. Silinmiş olabilir veya bağlantı eksik."
          }
        }
      }
    },
    "Privacy Policy": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik Politikası"
          }
        }
      }
    },
    "Private, deleted or unsupported playlists are explained in plain words.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli, silinmiş veya desteklenmeyen oynatma listeleri sade bir dille açıklanır."
          }
        }
      }
    },
    "Quit Playlist URL Extractor": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist URL Extractor'dan Çık"
          }
        }
      }
    },
    "Received an unexpected response. Please try again later.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklenmeyen bir yanıt alındı. Lütfen daha sonra tekrar deneyin."
          }
        }
      }
    },
    "Save as Text File…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin Olarak Kaydet…"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar"
          }
        }
      }
    },
    "Support": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destek"
          }
        }
      }
    },
    "That doesn't look like a playlist link or ID.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir oynatma listesi bağlantısı veya kimliği gibi görünmüyor."
          }
        }
      }
    },
    "The daily lookup limit has been reached. Please try again tomorrow.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük sorgu sınırına ulaşıldı. Lütfen yarın tekrar deneyin."
          }
        }
      }
    },
    "The file couldn't be saved.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya kaydedilemedi."
          }
        }
      }
    },
    "The service is temporarily unavailable. Please try again later.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hizmet geçici olarak kullanılamıyor. Lütfen daha sonra tekrar deneyin."
          }
        }
      }
    },
    "This link has no playlist in it. Use a link that contains “list=”.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bağlantıda oynatma listesi yok. “list=” içeren bir bağlantı kullanın."
          }
        }
      }
    },
    "This playlist has no available videos.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oynatma listesinde erişilebilir video yok."
          }
        }
      }
    },
    "This playlist is private. Only public and unlisted playlists can be listed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oynatma listesi gizli. Yalnızca herkese açık ve liste dışı oynatma listeleri listelenebilir."
          }
        }
      }
    },
    "Too many requests. Please wait a minute and try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla istek gönderildi. Lütfen bir dakika bekleyip tekrar deneyin."
          }
        }
      }
    },
    "Uses YouTube API Services. Not affiliated with YouTube or Google.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube API Hizmetlerini kullanır. YouTube veya Google ile bağlantılı değildir."
          }
        }
      }
    },
    "YouTube Terms of Service": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube Hizmet Şartları"
          }
        }
      }
    }
  },
  "version": "1.0"
}
